+/**
+ * Дэлгэц өөрийн үйлдлүүдийг бүртгэнэ. exec нь "prepare" шатанд state-ээ өөрчлөөд TERRE_DEFER буцаавал
+ * дараагийн render-ийн дараа (шинэ state-тэй) "run" шатаар дахин дуудагдана.
+ */
+export function useTerreView(name: string, exec: ViewExec) {
+  const execRef = useRef(exec);
+  execRef.current = exec;
+  const pending = useRef<{ action: string; params: any; resolve: (v: any) => void; reject: (e: any) => void } | null>(null);
+  const [tick, setTick] = useState(0);
+
+  useEffect(() => {
+    views[name] = (action, params) =>
+      new Promise((resolve, reject) => {
+        try {
+          const r = execRef.current(action, params, "prepare");
+          if (r === TERRE_DEFER) {
+            pending.current = { action, params, resolve, reject };
+            setTick((t) => t + 1);
+          } else {
+            Promise.resolve(r).then(resolve, reject);
+          }
+        } catch (e) {
+          reject(e);
+        }
+      });
+    return () => {
+      delete views[name];
+      if (pending.current) {
+        pending.current.reject(new Error("Дэлгэц хаагдсан тул үйлдэл тасарлаа"));
+        pending.current = null;
+      }
+    };
+  }, [name]);
+
+  useEffect(() => {
+    const job = pending.current;
+    if (!job) return;
+    pending.current = null;
+    Promise.resolve()
+      .then(() => execRef.current(job.action, job.params, "run"))
+      .then(job.resolve, job.reject);
+  }, [tick]);
+}
