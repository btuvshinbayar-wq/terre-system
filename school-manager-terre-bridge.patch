+/** Компьютер дээрх файлыг File объект болгож уншина (програмын импорт функцэд өгөхөд) */
+async function readFileAsFile(path: string): Promise<File> {
+  const clean = String(path || "").trim().replace(/^["']|["']$/g, "");
+  if (!clean) throw new Error("Файлын зам хоосон байна");
+  let size = 0;
+  try {
+    size = (await Neutralino.filesystem.getStats(clean)).size || 0;
+  } catch {
+    throw new Error(`Файл олдсонгүй: ${clean}`);
+  }
+  const CHUNK = 1024 * 1024;
+  const parts: ArrayBuffer[] = [];
+  for (let pos = 0; pos < size; pos += CHUNK) {
+    parts.push(await Neutralino.filesystem.readBinaryFile(clean, { pos, size: Math.min(CHUNK, size - pos) } as any));
+  }
+  if (size === 0) parts.push(await Neutralino.filesystem.readBinaryFile(clean));
+  const name = clean.split(/[\\/]/).pop() || "file";
+  const ext = (name.split(".").pop() || "").toLowerCase();
+  return new File(parts, name, { type: MIME[ext] || "application/octet-stream" });
+}
