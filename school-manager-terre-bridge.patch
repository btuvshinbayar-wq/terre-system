+/**
+ * Terre Bridge (renderer тал) — Terre System-ээс ирсэн тушаалыг React state-ээр дамжуулж гүйцэтгэнэ.
+ * Electron main процессын terre-bridge.cjs нь window.__terreBridge.handle(action, params)-г дуудна.
+ * Лиценз, тохиргооны нууц мэдээлэл (API түлхүүр, лицензийн код)-ийг хэзээ ч гадагш өгөхгүй.
+ */
+import { useEffect, MutableRefObject } from "react";
+import type { TabType } from "../components/RibbonHeader";
+import type {
+  AppSettings, AttendanceStatus, CategoryType, CurriculumAnalysis, CurriculumEvaluation,
+  LessonObservation, NoteItem, PlanItem, Teacher,
+} from "../types";
+import { buildFullSystemSyncPayload } from "./googleDriveSyncHelper";
+import { generateAndDownloadReportDocx } from "./docxExport";
+import { exportAttendanceToExcel, exportPlansToExcel } from "./excelHelper";
+
+export interface TerreContext {
+  settings: AppSettings;
+  plans: PlanItem[];
+  notes: NoteItem[];
+  teachers: Teacher[];
+  curriculumAnalyses: CurriculumAnalysis[];
+  curriculumEvaluations: CurriculumEvaluation[];
+  lessonObservations: LessonObservation[];
+  setPlans: React.Dispatch<React.SetStateAction<PlanItem[]>>;
+  setNotes: React.Dispatch<React.SetStateAction<NoteItem[]>>;
+  setTeachers: React.Dispatch<React.SetStateAction<Teacher[]>>;
+  setActiveTab: (t: TabType) => void;
+  showToast?: (msg: string) => void;
+  licensed?: boolean;
+}
+
+const STATUS_WORDS: Record<string, AttendanceStatus> = {
+  и: "И", ирсэн: "И", ирлээ: "И",
+  ө: "Ө", өвчтэй: "Ө", өвчин: "Ө",
+  ч: "Ч", чөлөөтэй: "Ч", чөлөө: "Ч",
+  т: "Т", тасалсан: "Т", таслалт: "Т",
+  х: "Х", хоцорсон: "Х", хоцролт: "Х",
+};
+const STATUS_LABEL: Record<AttendanceStatus, string> = { И: "Ирсэн", Ө: "Өвчтэй", Ч: "Чөлөөтэй", Т: "Тасалсан", Х: "Хоцорсон" };
+const PLAN_STATUS: Record<string, PlanItem["status"]> = {
+  "төлөвлөсөн": "төлөвлөсөн", "хийгдэж байгаа": "хийгдэж_байгаа", "хийгдэж_байгаа": "хийгдэж_байгаа",
+  "биелсэн": "биелсэн", "хойшилсон": "хойшилсон",
+};
+const TABS: TabType[] = ["dashboard", "calendar", "plan", "notes", "curriculum", "report", "timetable", "attendance", "consolidation", "settings"];
+
+const pad = (n: number) => String(n).padStart(2, "0");
+const ymd = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
+const norm = (s: string) => (s || "").toLowerCase().replace(/\s+/g, " ").trim();
+
+function findOne<T>(items: T[], query: string, label: (x: T) => string, what: string): T {
+  const q = norm(query);
+  if (!q) throw new Error(`${what} хоосон байна`);
+  const exact = items.filter((x) => norm(label(x)) === q);
+  if (exact.length === 1) return exact[0];
+  const tokens = q.split(" ");
+  const hits = items.filter((x) => tokens.every((t) => norm(label(x)).includes(t)));
+  if (hits.length === 1) return hits[0];
+  if (hits.length === 0) throw new Error(`"${query}" нэртэй ${what} олдсонгүй`);
+  throw new Error(`"${query}" олон ${what}-тай таарлаа: ${hits.slice(0, 6).map(label).join(", ")}`);
+}
+
+function monthRange(month?: string) {
+  const now = new Date();
+  const [y, m] = (month || `${now.getFullYear()}-${pad(now.getMonth() + 1)}`).split("-").map(Number);
+  return { y, m, start: new Date(y, m - 1, 1).getTime(), end: new Date(y, m, 0, 23, 59, 59).getTime(), title: `${y} оны ${m}-р сар` };
+}
+
+function save(key: string, value: unknown) {
+  try {
+    localStorage.setItem(key, JSON.stringify(value));
+  } catch (e) {
+    console.error("Terre bridge save failed", key, e);
+  }
+}
+
+function summary(c: TerreContext, date?: string) {
+  const today = date || ymd(new Date());
+  const counts: Record<string, number> = { И: 0, Ө: 0, Ч: 0, Т: 0, Х: 0 };
+  const absent: { name: string; status: string }[] = [];
+  for (const t of c.teachers) {
+    const s = (t.attendanceRecords && t.attendanceRecords[today]) || "И";
+    counts[s] = (counts[s] || 0) + 1;
+    if (s !== "И") absent.push({ name: t.fullName, status: STATUS_LABEL[s as AttendanceStatus] || s });
+  }
+  const { start, end } = monthRange(today.slice(0, 7));
+  const monthNotes = c.notes.filter((n) => {
+    const t = new Date(n.startDate).getTime();
+    return t >= start && t <= end;
+  });
+  const monthPlans = c.plans.filter((p) => {
+    const t1 = new Date(p.startDate || p.endDate).getTime();
+    const t2 = new Date(p.endDate || p.startDate).getTime();
+    return (t1 >= start && t1 <= end) || (t2 >= start && t2 <= end);
+  });
+  const byStatus: Record<string, number> = {};
+  monthPlans.forEach((p) => (byStatus[p.status] = (byStatus[p.status] || 0) + 1));
+  const in7 = ymd(new Date(Date.now() + 7 * 86400000));
+  const overdue = c.plans
+    .filter((p) => p.endDate && p.endDate < today && p.status !== "биелсэн")
+    .map((p) => ({ id: p.id, activity: p.activity, endDate: p.endDate, status: p.status }));
+  const upcoming = c.plans
+    .filter((p) => p.startDate >= today && p.startDate <= in7 && p.status === "төлөвлөсөн")
+    .map((p) => ({ id: p.id, activity: p.activity, startDate: p.startDate }));
+  return {
+    date: today,
+    school: c.settings.schoolName,
+    manager: c.settings.managerName,
+    teachers: { total: c.teachers.length, counts, absent },
+    notes: {
+      month: monthNotes.length,
+      monthHours: Math.round(monthNotes.reduce((a, n) => a + (Number(n.spentHours) || 0), 0) * 10) / 10,
+      today: c.notes.filter((n) => (n.startDate || "").startsWith(today)).length,
+    },
+    plans: { month: monthPlans.length, byStatus, overdue: overdue.slice(0, 15), upcoming: upcoming.slice(0, 15) },
+    teacherNames: c.teachers.map((t) => t.fullName),
+  };
+}
+
+function makeHandlers(ref: MutableRefObject<TerreContext | null>) {
+  const ctx = () => {
+    if (!ref.current) throw new Error("School Manager бэлэн биш байна");
+    return ref.current;
+  };
+  const toast = (m: string) => ctx().showToast?.(`🤖 Terre: ${m}`);
+
+  const handlers: Record<string, (p: any) => any> = {
+    info: () => ({ school: ctx().settings.schoolName, manager: ctx().settings.managerName, tabs: TABS }),
+
+    summary: (p) => summary(ctx(), p?.date),
+
+    teachers: (p) => {
+      const day = p?.date || ymd(new Date());
+      return ctx().teachers.map((t) => ({
+        id: t.id, name: t.fullName, profession: t.profession,
+        status: STATUS_LABEL[((t.attendanceRecords || {})[day] || "И") as AttendanceStatus],
+      }));
+    },
+
+    plans: (p) => {
+      let list = ctx().plans;
+      if (p?.month) {
+        const { start, end } = monthRange(p.month);
+        list = list.filter((x) => {
+          const t = new Date(x.startDate || x.endDate).getTime();
+          return t >= start && t <= end;
+        });
+      }
+      if (p?.status) list = list.filter((x) => x.status === (PLAN_STATUS[norm(p.status)] || p.status));
+      return list.slice(0, p?.limit || 100).map(({ id, activity, startDate, endDate, status, type }) => ({ id, activity, startDate, endDate, status, type }));
+    },
+
+    notes: (p) =>
+      [...ctx().notes]
+        .sort((a, b) => (b.startDate || "").localeCompare(a.startDate || ""))
+        .slice(0, p?.limit || 20)
+        .map(({ id, title, category, startDate, spentHours, resultConclusion }) => ({ id, title, category, startDate, spentHours, resultConclusion })),
+
+    set_attendance: (p) => {
+      const c = ctx();
+      const teacher = findOne(c.teachers, p?.teacher, (t) => t.fullName, "багш");
+      const status = STATUS_WORDS[norm(p?.status)];
+      if (!status) throw new Error(`Төлөв буруу: "${p?.status}" (Ирсэн/Өвчтэй/Чөлөөтэй/Тасалсан/Хоцорсон)`);
+      const day = p?.date || ymd(new Date());
+      c.setTeachers((prev) => {
+        const next = prev.map((t) => {
+          if (t.id !== teacher.id) return t;
+          const detail = (t.attendanceDetails || {})[day] || {};
+          return {
+            ...t,
+            attendanceRecords: { ...t.attendanceRecords, [day]: status },
+            attendanceDetails: {
+              ...t.attendanceDetails,
+              [day]: {
+                ...detail,
+                status,
+                ...(p?.note ? { note: String(p.note) } : {}),
+                ...(status === "Х" && p?.lateMinutes ? { lateMinutes: Number(p.lateMinutes) } : {}),
+              },
+            },
+          };
+        });
+        save("sms_teachers", next);
+        return next;
+      });
+      toast(`${teacher.fullName} — ${day}: ${STATUS_LABEL[status]}`);
+      return { teacher: teacher.fullName, date: day, status: STATUS_LABEL[status] };
+    },
+
+    add_note: (p) => {
+      const c = ctx();
+      if (!p?.title) throw new Error("Гарчиг (title) шаардлагатай");
+      const day = p.date || ymd(new Date());
+      const startTime = p.startTime || "09:00";
+      const hours = Number(p.hours) || 1;
+      const startMs = new Date(`${day}T${startTime}`).getTime();
+      const end = new Date(startMs + hours * 3600000);
+      let planId: string | undefined;
+      if (p.plan) planId = findOne(c.plans, p.plan, (x) => x.activity, "төлөвлөгөө").id;
+      const nowIso = new Date().toISOString();
+      const note: NoteItem = {
+        id: "note_" + Date.now(),
+        title: String(p.title),
+        category: (p.category || "бусад") as CategoryType,
+        planId,
+        isUnplanned: !planId,
+        startDate: `${day}T${startTime}`,
+        endDate: `${ymd(end)}T${pad(end.getHours())}:${pad(end.getMinutes())}`,
+        spentHours: hours,
+        participantsCount: Number(p.participants) || 0,
+        resultConclusion: String(p.result || ""),
+        cautionNotes: String(p.caution || ""),
+        improvementSuggestions: String(p.suggestion || ""),
+        images: [],
+        teacherName: p.teacherName || undefined,
+        createdAt: nowIso,
+        updatedAt: nowIso,
+      };
+      c.setNotes((prev) => {
+        const next = [note, ...prev];
+        save("sms_notes", next);
+        return next;
+      });
+      toast(`тэмдэглэл нэмлээ: ${note.title}`);
+      return { id: note.id, title: note.title };
+    },
+
+    set_plan_status: (p) => {
+      const c = ctx();
+      const plan = p?.id ? c.plans.find((x) => x.id === p.id) : findOne(c.plans, p?.plan, (x) => x.activity, "төлөвлөгөө");
+      if (!plan) throw new Error("Төлөвлөгөө олдсонгүй");
+      const status = PLAN_STATUS[norm(p?.status)];
+      if (!status) throw new Error(`Төлөв буруу: "${p?.status}"`);
+      c.setPlans((prev) => {
+        const next = prev.map((x) => (x.id === plan.id ? { ...x, status } : x));
+        save("sms_plans", next);
+        return next;
+      });
+      toast(`«${plan.activity}» → ${status.replace("_", " ")}`);
+      return { activity: plan.activity, status };
+    },
+
+    add_plan: (p) => {
+      const c = ctx();
+      if (!p?.activity) throw new Error("Үйл ажиллагаа (activity) шаардлагатай");
+      const today = ymd(new Date());
+      const plan: PlanItem = {
+        id: "plan_" + Date.now(),
+        dd: c.plans.length + 1,
+        activity: String(p.activity),
+        goal: String(p.goal || ""),
+        startDate: p.startDate || today,
+        endDate: p.endDate || p.startDate || today,
+        scope: String(p.scope || ""),
+        responsibleUnit: String(p.responsibleUnit || "Сургалтын алба"),
+        expectedResult: String(p.expectedResult || ""),
+        type: p.type === "жилийн" ? "жилийн" : "сарын",
+        status: "төлөвлөсөн",
+      };
+      c.setPlans((prev) => {
+        const next = [...prev, plan];
+        save("sms_plans", next);
+        return next;
+      });
+      toast(`төлөвлөгөө нэмлээ: ${plan.activity}`);
+      return { id: plan.id, activity: plan.activity };
+    },
+
+    navigate: (p) => {
+      if (!TABS.includes(p?.tab)) throw new Error(`Цонх буруу: ${p?.tab}`);
+      ctx().setActiveTab(p.tab);
+      return { tab: p.tab };
+    },
+
+    // main процесс will-download-аар баригдаж Terre-ийн заасан зам руу хадгалагдана
+    export: async (p) => {
+      const c = ctx();
+      const { y, m, start, end, title } = monthRange(p?.month);
+      if (p?.kind === "attendance_xlsx") {
+        exportAttendanceToExcel(c.teachers, y, m);
+      } else if (p?.kind === "plans_xlsx") {
+        exportPlansToExcel(c.plans);
+      } else if (p?.kind === "report_docx") {
+        const inRange = (d?: string) => {
+          if (!d) return false;
+          const t = new Date(d).getTime();
+          return t >= start && t <= end;
+        };
+        await generateAndDownloadReportDocx(
+          `${c.settings.schoolName || "Сургууль"} ${title} ажлын тайлан`,
+          c.notes.filter((n) => inRange(n.startDate)),
+          c.plans.filter((x) => inRange(x.startDate) || inRange(x.endDate)),
+          c.settings,
+          undefined,
+          "operational",
+          c.curriculumEvaluations.filter((e) => inRange(e.date)),
+          c.lessonObservations.filter((o) => inRange(o.date)),
+          c.teachers
+        );
+      } else {
+        throw new Error(`Экспортын төрөл буруу: ${p?.kind}`);
+      }
+      return { ok: true };
+    },
+
+    backup_payload: () => {
+      const c = ctx();
+      return JSON.stringify(
+        buildFullSystemSyncPayload({
+          settings: c.settings, plans: c.plans, notes: c.notes, teachers: c.teachers,
+          curriculumAnalyses: c.curriculumAnalyses, curriculumEvaluations: c.curriculumEvaluations,
+          lessonObservations: c.lessonObservations,
+        }),
+        null,
+        2
+      );
+    },
+  };
+  return handlers;
+}
+
+export function useTerreBridge(ref: MutableRefObject<TerreContext | null>) {
+  useEffect(() => {
+    const handlers = makeHandlers(ref);
+    (window as any).__terreBridge = {
+      handle: async (action: string, params: any) => {
+        const fn = handlers[action];
+        if (!fn) throw new Error(`Үл мэдэх үйлдэл: ${action}`);
+        if (action !== "info" && ref.current && ref.current.licensed === false) {
+          throw new Error("School Manager идэвхжээгүй (лиценз) байна");
+        }
+        return fn(params || {});
+      },
+    };
+    return () => {
+      delete (window as any).__terreBridge;
+    };
+  }, [ref]);
+}
