+/** Хоёртын файлыг хэсэгчлэн бичнэ (том Word/Excel файлд Neutralino-ийн холболт тасрахгүйн тулд) */
+const WRITE_CHUNK_BYTES = 192 * 1024;
+export async function writeBinaryChunked(p: string, data: ArrayBuffer): Promise<void> {
+  if (data.byteLength <= WRITE_CHUNK_BYTES) {
+    await Neutralino.filesystem.writeBinaryFile(p, data);
+    return;
+  }
+  await Neutralino.filesystem.writeBinaryFile(p, data.slice(0, WRITE_CHUNK_BYTES));
+  for (let pos = WRITE_CHUNK_BYTES; pos < data.byteLength; pos += WRITE_CHUNK_BYTES) {
+    await Neutralino.filesystem.appendBinaryFile(p, data.slice(pos, pos + WRITE_CHUNK_BYTES));
+  }
+}
+
