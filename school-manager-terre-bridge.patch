+// ---------------------------------------------------------------------------
+// Файлын шуудангийн хайрцаг (Neutralino)
+// ---------------------------------------------------------------------------
+const READ_ONLY = new Set(["ping", "info"]);
+const MAX_AGE_MS = 3 * 60 * 1000;
+
+function joinPath(...parts: string[]) {
+  const sep = (window as any).NL_OS === "Windows" ? "\\" : "/";
+  return parts
+    .filter(Boolean)
+    .map((p, i) => (i === 0 ? p.replace(/[\\/]+$/, "") : p.replace(/^[\\/]+|[\\/]+$/g, "")))
+    .join(sep);
+}
+
+async function ensureDir(p: string) {
+  try {
+    await Neutralino.filesystem.getStats(p);
+  } catch {
+    await Neutralino.filesystem.createDirectory(p);
+  }
+}
+
+function randomToken() {
+  const a = new Uint8Array(24);
+  crypto.getRandomValues(a);
+  return Array.from(a, (b) => b.toString(16).padStart(2, "0")).join("");
+}
+
+/** Арын цонхонд (minimized) таймер удааширдаг тул Worker-оос "цохилт" авна */
+function startTicker(fn: () => void, ms: number): () => void {
+  try {
+    const src = `setInterval(() => postMessage(0), ${ms});`;
+    const url = URL.createObjectURL(new Blob([src], { type: "text/javascript" }));
+    const w = new Worker(url);
+    w.onmessage = () => fn();
+    return () => w.terminate();
+  } catch {
+    const id = setInterval(fn, ms);
+    return () => clearInterval(id);
+  }
+}
+
+async function startFileTransport(handle: (action: string, params: any) => Promise<any>): Promise<() => void> {
+  const appData = (await Neutralino.os.getEnv("APPDATA")) || (await Neutralino.os.getPath("data"));
+  const root = joinPath(appData, "TerreBridge");
+  const box = joinPath(root, "school-manager");
+  const inbox = joinPath(box, "inbox");
+  const outbox = joinPath(box, "outbox");
+  for (const d of [root, box, inbox, outbox]) await ensureDir(d);
+
+  // Өмнөх ажиллагаанаас үлдсэн хуучин тушаал, хариуг цэвэрлэнэ (зөвхөн энэ хавтасны .json/.tmp файлууд)
+  for (const dir of [inbox, outbox]) {
+    try {
+      for (const e of await Neutralino.filesystem.readDirectory(dir)) {
+        if (e.type === "FILE" && /\.(json|tmp)$/i.test(e.entry)) await Neutralino.filesystem.remove(joinPath(dir, e.entry)).catch(() => {});
+      }
+    } catch {}
+  }
+
+  const token = randomToken();
+  const infoFile = joinPath(root, "school-manager.json");
+  const startedAt = new Date().toISOString();
+  let dataDir: string | null = null;
+  try {
+    dataDir = (await window.dataMirror?.getLocation?.())?.dir || null;
+  } catch {}
+
+  const writeInfo = async () => {
+    const info = {
+      app: "School Manager",
+      edition: "lite",
+      transport: "file",
+      version: TERRE_BRIDGE_VERSION,
+      token,
+      inbox,
+      outbox,
+      dataDir,
+      startedAt,
+      heartbeat: new Date().toISOString(),
+    };
+    try {
+      await Neutralino.filesystem.writeFile(infoFile, JSON.stringify(info, null, 2));
+    } catch (e) {
+      console.warn("Terre bridge: мэдээллийн файл бичиж чадсангүй", e);
+    }
+  };
+  await writeInfo();
+
+  const respond = async (id: string, body: unknown) => {
+    const tmp = joinPath(outbox, `${id}.tmp`);
+    const out = joinPath(outbox, `${id}.json`);
+    await writeBinaryChunked(tmp, new TextEncoder().encode(JSON.stringify(body)).buffer as ArrayBuffer);
+    await Neutralino.filesystem.move(tmp, out);
+  };
+
+  let busy = false;
+  let beat = 0;
+  const tick = async () => {
+    if (++beat % 5 === 0) void writeInfo();
+    if (busy) return;
+    busy = true;
+    try {
+      const entries = await Neutralino.filesystem.readDirectory(inbox);
+      const files = entries.filter((e) => e.type === "FILE" && /^[A-Za-z0-9_-]{1,64}\.json$/.test(e.entry)).map((e) => e.entry).sort();
+      for (const name of files) {
+        const id = name.replace(/\.json$/, "");
+        const full = joinPath(inbox, name);
+        let raw = "";
+        try {
+          raw = await Neutralino.filesystem.readFile(full);
+        } catch {
+          continue;
+        }
+        await Neutralino.filesystem.remove(full).catch(() => {});
+        let msg: any;
+        try {
+          msg = JSON.parse(raw);
+        } catch {
+          continue; // дутуу бичигдсэн / буруу файл
+        }
+        if (!msg || msg.token !== token) continue; // хариу өгөхгүй
+        if (typeof msg.ts === "number" && Date.now() - msg.ts > MAX_AGE_MS) {
+          await respond(id, { id, ok: false, error: "Тушаал хуучирсан байна" });
+          continue;
+        }
+        try {
+          const result = await handle(String(msg.action || ""), msg.params || {});
+          await respond(id, { id, ok: true, result: result ?? null });
+        } catch (e: any) {
+          await respond(id, { id, ok: false, error: e?.message || String(e) });
+        }
+      }
+    } catch (e) {
+      console.warn("Terre bridge:", e);
+    } finally {
+      busy = false;
+    }
+  };
+
+  return startTicker(() => void tick(), 1000);
+}
+
+/**
+ * App.tsx-д нэг удаа дуудна. Lite (Neutralino) дотор ажиллаж байвал Terre-тэй холбогдоно.
+ */
+export function useTerreBridge(ref: MutableRefObject<TerreContext | null>) {
+  useEffect(() => {
+    const handlers = makeHandlers(ref);
+    const handle = async (action: string, params: any) => {
+      const fn = handlers[action];
+      if (!fn) throw new Error(`Үл мэдэх үйлдэл: ${action}`);
+      if (!READ_ONLY.has(action) && ref.current && !ref.current.licensed) {
+        throw new Error("School Manager идэвхжээгүй (лиценз) байна");
+      }
+      return fn(params || {});
+    };
+    (window as any).__terreBridge = { handle, version: TERRE_BRIDGE_VERSION };
+
+    if (!isNeutralino()) {
+      return () => {
+        delete (window as any).__terreBridge;
+      };
+    }
+    let stop: (() => void) | null = null;
+    let cancelled = false;
+    startFileTransport(handle)
+      .then((s) => {
+        if (cancelled) s();
+        else stop = s;
+      })
+      .catch((e) => console.warn("Terre bridge эхэлсэнгүй:", e));
+    return () => {
+      cancelled = true;
+      stop?.();
+      delete (window as any).__terreBridge;
+    };
+  }, [ref]);
+}
+
+/** Зөвхөн автомат тестэд (програмд ашиглагдахгүй) */
+export const __terreTest = { makeHandlers, startFileTransport };
