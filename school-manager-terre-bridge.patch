+/**
+ * Terre Bridge — Terre System (хувийн туслах) School Manager-тэй ярилцах дотоод холболт.
+ *
+ * - Зөвхөн энэ компьютер дотор (127.0.0.1) сонсоно, гаднаас хандах боломжгүй.
+ * - Програм асах бүрт шинэ нууц token үүсгэж, %APPDATA%\TerreBridge\school-manager.json-д бичнэ.
+ *   Энэ файлыг уншиж чадах програм (тухайн Windows хэрэглэгч) л хандана.
+ * - Бүх өөрчлөлт React state-ээр дамжиж, програмын өөрийн хадгалалтын логикоор хадгалагдана.
+ * - Лиценз, машины ID-д огт хүрэхгүй.
+ */
+const http = require("http");
+const crypto = require("crypto");
+const fs = require("fs");
+const path = require("path");
+
+const MAX_BODY = 1024 * 1024;
+
+module.exports = function startTerreBridge({ app, session, getWindow }) {
+  const token = crypto.randomBytes(24).toString("hex");
+  const infoDir = path.join(app.getPath("appData"), "TerreBridge");
+  const infoFile = path.join(infoDir, "school-manager.json");
+  let pendingSave = null; // { path, resolve, reject, timer }
+
+  // Тайлан экспорт (a.click / XLSX.writeFile) → харилцах цонхгүйгээр Terre-ийн заасан зам руу хадгална
+  session.defaultSession.on("will-download", (_e, item) => {
+    if (!pendingSave) return;
+    const job = pendingSave;
+    pendingSave = null;
+    clearTimeout(job.timer);
+    try {
+      fs.mkdirSync(path.dirname(job.path), { recursive: true });
+    } catch (e) {}
+    item.setSavePath(job.path);
+    item.once("done", (_ev, state) => {
+      if (state === "completed") job.resolve(job.path);
+      else job.reject(new Error("Татаж хадгалах амжилтгүй: " + state));
+    });
+  });
+
+  function waitForDownload(savePath) {
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => {
+        if (pendingSave && pendingSave.path === savePath) pendingSave = null;
+        reject(new Error("Экспорт хугацаандаа дууссангүй"));
+      }, 60000);
+      pendingSave = { path: savePath, resolve, reject, timer };
+    });
+  }
+
+  async function callRenderer(win, action, params) {
+    const js =
+      "window.__terreBridge ? window.__terreBridge.handle(" +
+      JSON.stringify(action) + "," + JSON.stringify(params || {}) +
+      ") : Promise.reject(new Error('School Manager бүрэн ачаалагдаагүй байна'))";
+    return win.webContents.executeJavaScript(js, true);
+  }
+
+  async function handle(action, params) {
+    const win = getWindow();
+    if (!win || win.isDestroyed()) throw new Error("School Manager-ийн цонх нээгдээгүй байна");
+
+    if (action === "focus") {
+      if (win.isMinimized()) win.restore();
+      win.show();
+      win.focus();
+      return { ok: true };
+    }
+
+    if (action === "export") {
+      const savePath = params && params.path;
+      if (!savePath || !path.isAbsolute(savePath)) throw new Error("Хадгалах бүтэн зам (path) шаардлагатай");
+      if (params.kind === "backup") {
+        const json = await callRenderer(win, "backup_payload", params);
+        fs.mkdirSync(path.dirname(savePath), { recursive: true });
+        fs.writeFileSync(savePath, json, "utf8");
+        return { ok: true, path: savePath };
+      }
+      const done = waitForDownload(savePath);
+      try {
+        await callRenderer(win, "export", params);
+      } catch (e) {
+        if (pendingSave && pendingSave.path === savePath) {
+          clearTimeout(pendingSave.timer);
+          pendingSave = null;
+        }
+        throw e;
+      }
+      return { ok: true, path: await done };
+    }
+
+    return callRenderer(win, action, params);
+  }
+
+  const server = http.createServer((req, res) => {
+    const send = (code, obj) => {
+      res.writeHead(code, { "Content-Type": "application/json; charset=utf-8" });
+      res.end(JSON.stringify(obj));
+    };
+    const addr = req.socket.remoteAddress || "";
+    if (!["127.0.0.1", "::1", "::ffff:127.0.0.1"].includes(addr)) return send(403, { error: "forbidden" });
+    if (req.headers["x-terre-token"] !== token) return send(401, { error: "unauthorized" });
+
+    if (req.method === "GET" && req.url === "/ping") {
+      return send(200, { ok: true, app: "School Manager", version: app.getVersion() });
+    }
+    if (req.method !== "POST" || req.url !== "/action") return send(404, { error: "not found" });
+
+    let body = "";
+    req.on("data", (chunk) => {
+      body += chunk;
+      if (body.length > MAX_BODY) req.destroy();
+    });
+    req.on("end", async () => {
+      try {
+        const { action, params } = JSON.parse(body || "{}");
+        if (typeof action !== "string") throw new Error("action шаардлагатай");
+        const result = await handle(action, params);
+        send(200, { ok: true, result });
+      } catch (e) {
+        send(400, { ok: false, error: (e && e.message) || String(e) });
+      }
+    });
+  });
+
+  server.listen(0, "127.0.0.1", () => {
+    try {
+      fs.mkdirSync(infoDir, { recursive: true });
+      fs.writeFileSync(
+        infoFile,
+        JSON.stringify({ port: server.address().port, token, pid: process.pid, version: app.getVersion() }, null, 2),
+        "utf8"
+      );
+    } catch (e) {
+      console.error("Terre bridge info write failed:", e);
+    }
+  });
+
+  app.on("will-quit", () => {
+    try {
+      const cur = JSON.parse(fs.readFileSync(infoFile, "utf8"));
+      if (cur.pid === process.pid) fs.unlinkSync(infoFile);
+    } catch (e) {}
+    server.close();
+  });
+};
