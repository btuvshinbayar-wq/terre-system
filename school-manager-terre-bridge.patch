+    c.setActiveTab(tab);
+    for (let i = 0; i < 100 && !views[name]; i++) await sleep(100);
+    if (!views[name]) throw new Error("Дэлгэц нээгдэхгүй байна");
+  }
+  return views[name](action, params);
+}
