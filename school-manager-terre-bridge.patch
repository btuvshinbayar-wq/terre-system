+/** Дараагийн "татах" (download) үйлдлийг заасан зам руу хадгална */
+function captureDownload(path: string, run: () => unknown, timeoutMs = 90000): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const timer = setTimeout(() => {
+      (window as any).__terreDownload = null;
+      reject(new Error("Файл үүссэнгүй (хугацаа хэтэрлээ)"));
+    }, timeoutMs);
+    (window as any).__terreDownload = {
+      path,
+      resolve: (p: string) => {
+        clearTimeout(timer);
+        resolve(p);
+      },
+      reject: (e: unknown) => {
+        clearTimeout(timer);
+        reject(e);
+      },
+    };
+    Promise.resolve()
+      .then(run)
+      .catch((e) => {
+        clearTimeout(timer);
+        (window as any).__terreDownload = null;
+        reject(e);
+      });
+  });
+}
