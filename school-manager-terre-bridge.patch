+function findOne<T>(items: T[], query: unknown, label: (x: T) => string, what: string): T {
+  const q = norm(query);
+  if (!q) throw new Error(`${what} хоосон байна`);
+  const exact = items.filter((x) => norm(label(x)) === q);
+  if (exact.length === 1) return exact[0];
+  const tokens = q.split(" ");
+  const hits = items.filter((x) => tokens.every((t) => norm(label(x)).includes(t)));
+  if (hits.length === 1) return hits[0];
+  if (hits.length === 0) throw new Error(`"${query}" гэсэн ${what} олдсонгүй`);
+  throw new Error(`"${query}" олон ${what}-тай таарлаа: ${hits.slice(0, 6).map(label).join(", ")}`);
